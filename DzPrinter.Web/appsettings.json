{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Printer": {
    "Transport": "file",
    "File": {
      "OutputPath": "output/print.bin",
      "Format": "RawBinary",
      "SavePngPreview": true,
      "PngOutputPath": "output/preview.png",
      "PngScale": 2
    },
    "Ble": {
      "ServiceUuid": "000018f0-0000-1000-8000-00805f9b34fb",
      "PackSize": 20,
      "ScanTimeoutMs": 5000
    },
    "Hid": {
      "NameContains": "Printer",
      "ReportId": 0,
      "ReadTimeoutMs": 500,
      "WriteTimeoutMs": 2000,
      "SendIntervalMs": 20
    }
  }
}
