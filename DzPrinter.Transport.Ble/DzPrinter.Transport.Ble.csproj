<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DzPrinter.Transport.Ble</RootNamespace>
    <AssemblyName>DzPrinter.Transport.Ble</AssemblyName>
    <!--
      Windows BLE 传输实现（基于 WinRT）。
      对应 JS 中的 We (WebBluetooth) 与 hi (BleConnection) 的底层 WinRT 版本。
      只能在 Windows 10 1903+ 运行。
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DzPrinter.Transport\DzPrinter.Transport.csproj" />
  </ItemGroup>

</Project>
