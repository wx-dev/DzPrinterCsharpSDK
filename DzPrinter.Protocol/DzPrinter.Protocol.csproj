<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DzPrinter.Protocol</RootNamespace>
    <AssemblyName>DzPrinter.Protocol</AssemblyName>
    <!-- 兼容 Windows 上的 GBK 解码（CodePagesEncodingProvider） -->
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      GBK 字符串解码依赖 System.Text.Encoding.CodePages。
      Transport 模块将来引用 WinRT 时可再加 TargetFramework=net8.0-windows10.0.19041.0。
    -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DzImageData 的规范归属在 Imaging 模块；Protocol 复用其类型与灰度算法。 -->
    <ProjectReference Include="..\DzPrinter.Imaging\DzPrinter.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core 提供日志抽象与传输接口。 -->
    <ProjectReference Include="..\DzPrinter.Core\DzPrinter.Core.csproj" />
  </ItemGroup>

</Project>
