<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DzPrinter.Transport</RootNamespace>
    <AssemblyName>DzPrinter.Transport</AssemblyName>
    <!--
      传输层抽象模块。
      职责：
        传输层接口 (IDeviceTransport) + 连接状态枚举 (ConnectionState/TransportType) + 设备信息 (DeviceInfo)
      平台无关，不引用任何 Windows SDK。
      设备连接实现 (DeviceConnection/BleConnection/HidConnection) 位于 Printer 层。
      依赖 Core (日志、工具)。
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DzPrinter.Core\DzPrinter.Core.csproj" />
  </ItemGroup>

</Project>
