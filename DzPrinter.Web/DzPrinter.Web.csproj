<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DzPrinter.Web</RootNamespace>
    <AssemblyName>DzPrinter.Web</AssemblyName>
    <!--
      Web API 层。通过 HTTP 接口暴露打印机 SDK 能力。
      目标框架取 net8.0-windows10.0.19041.0 以同时支持 BLE / HID / File 三种传输。
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DzPrinter.Core\DzPrinter.Core.csproj" />
    <ProjectReference Include="..\DzPrinter.Transport\DzPrinter.Transport.csproj" />
    <ProjectReference Include="..\DzPrinter.Transport.BleXPlat\DzPrinter.Transport.BleXPlat.csproj" />
    <ProjectReference Include="..\DzPrinter.Transport.Hid\DzPrinter.Transport.Hid.csproj" />
    <ProjectReference Include="..\DzPrinter.Transport.File\DzPrinter.Transport.File.csproj" />
    <ProjectReference Include="..\DzPrinter.Drawing\DzPrinter.Drawing.csproj" />
    <ProjectReference Include="..\DzPrinter.Imaging\DzPrinter.Imaging.csproj" />
    <ProjectReference Include="..\DzPrinter.Barcode\DzPrinter.Barcode.csproj" />
    <ProjectReference Include="..\DzPrinter.Jobs\DzPrinter.Jobs.csproj" />
    <ProjectReference Include="..\DzPrinter.Printer\DzPrinter.Printer.csproj" />
  </ItemGroup>

</Project>
